# Backend Environment Variables

# Server Port
PORT=3000

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/sustainable-product-rating

# JWT Secret Key (use a strong, random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Sign-In (OpenID Connect authorization code flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on the Google OAuth client,
# e.g. http://localhost:3000/api/auth/google/callback (same port as PORT)
GOOGLE_REDIRECT_URI=

# Frontend origin, no trailing slash (used for CORS and post-login redirects)
FRONTEND_URL=

# Change to 'production' in production environment
NODE_ENV=development
